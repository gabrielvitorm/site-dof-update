# Copie para `.env` na raiz: `cp .env.example .env`
# Um único arquivo para Docker deploy e dev local (API + Vite).

# --- App / runtime ---
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3001
HTTP_PORT=8080

# Local API (Docker Compose sobrescreve DATABASE_URL no container)
DATABASE_URL=postgresql://dof_user:dof_local_dev@127.0.0.1:5432/dofupdate

# --- Postgres (compose) ---
POSTGRES_DB=dofupdate
POSTGRES_USER=dof_user
POSTGRES_PASSWORD=dof_local_dev
POSTGRES_PORT=5432

# --- Public / checkout ---
EVENT_PRICE_BRL=320
SALES_PHASE=Ultimo lote
EVEN3_CHECKOUT_URL=https://www.even3.com.br/auxcheckout/redirect?urlEvento=dof-update-iii-imersao-interprofissional-em-dtm-e-dores-orofaciais-698642&idIngresso=820401&lang=pt
EVEN3_FALLBACK_URL=https://www.even3.com.br/dof-update-iii-imersao-interprofissional-em-dtm-e-dores-orofaciais-698642/
GROUP_FORM_URL=https://forms.gle/aSKo8XbHoPgSzHXn9
MAPS_URL=https://www.google.com/maps/dir/?api=1&destination=Av.%20Vit%C3%B3ria%2C%202220%20-%20Monte%20Belo%2C%20Vit%C3%B3ria%20-%20ES%2C%2029053-360
SALES_ENABLED=true

# --- Secrets ---
EVEN3_WEBHOOK_PATH_SECRET=replace-with-high-entropy-secret
N8N_INTERNAL_WEBHOOK_URL=http://127.0.0.1:5678/webhook/local-dev
N8N_INTERNAL_TOKEN=local-dev-n8n-token

# --- Rate limit / logs ---
LEAD_RATE_LIMIT_MAX=100
LEAD_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
PII_LOG_MASKING=true

# --- Frontend (Vite build + SEO) ---
VITE_SITE_URL=https://dofupdate.com.br
VITE_GA4_MEASUREMENT_ID=G-T21VTEB82Y
VITE_META_PIXEL_ID=1260445516208115
