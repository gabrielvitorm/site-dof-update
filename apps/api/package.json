{
  "name": "@dof-update/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:runtime && npm run build:migrations",
    "build:runtime": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --external:fastify --external:pg --external:pg-native",
    "build:migrations": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file=../../.env src/server.ts",
    "migrate": "tsx --env-file=../../.env src/db/run-migrate.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@dof-update/contracts": "0.1.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "esbuild": "^0.25.0",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.2"
  }
}
