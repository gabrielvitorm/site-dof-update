{
  "name": "@dof-update/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/db/run-migrate.ts",
    "start": "node --env-file=.env dist/server.js"
  },
  "dependencies": {
    "@dof-update/contracts": "0.1.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.2"
  }
}
