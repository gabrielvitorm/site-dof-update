# Public/app
NODE_ENV=production
APP_BASE_URL=https://example.com
PORT=3000

# Database
DATABASE_URL=postgresql://dof_user:change-me@postgres:5432/dofupdate

# Checkout/public config
EVENT_PRICE_BRL=320
SALES_PHASE=Ultimo lote
EVEN3_CHECKOUT_URL=https://www.even3.com.br/REPLACE_DIRECT_PAYMENT_LINK
EVEN3_FALLBACK_URL=https://www.even3.com.br/REPLACE_EVENT_OR_ENTRIES_LINK
GROUP_FORM_URL=https://forms.gle/aSKo8XbHoPgSzHXn9
MAPS_URL=https://maps.google.com/REPLACE
SALES_ENABLED=true

# Even3 webhook
EVEN3_WEBHOOK_PATH_SECRET=replace-with-high-entropy-secret

# Lead API rate limiting
LEAD_RATE_LIMIT_MAX=20
LEAD_RATE_LIMIT_WINDOW_MS=60000

# n8n internal dispatch
N8N_INTERNAL_WEBHOOK_URL=https://n8n.example.com/webhook/replace
N8N_INTERNAL_TOKEN=replace

# Analytics public IDs are safe only if they are truly public identifiers
VITE_GA4_MEASUREMENT_ID=G-REPLACE
VITE_META_PIXEL_ID=REPLACE

# Server-side Meta CAPI, if used
META_CAPI_ACCESS_TOKEN=replace
META_CAPI_DATASET_OR_PIXEL_ID=replace

# Logging
LOG_LEVEL=info
PII_LOG_MASKING=true
